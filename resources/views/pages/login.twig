{% extends "layouts/app.twig" %}
{% import 'macros/base.twig' as m %}

{% block title %}{{ __('general.login') }}{% endblock %}

{% block content %}
<div class="login-container">
    <div class="doodle-background">
        <!-- Floating Doodles -->
        <svg class="floating-svg" style="top: 5%; left: 5%; width: 150px; opacity: 0.1;" viewBox="0 0 200 200">
            <!-- Mandala-like pattern -->
            <circle cx="100" cy="100" r="80" stroke="#6366f1" stroke-width="1" fill="none" stroke-dasharray="5 5" />
            <circle cx="100" cy="100" r="60" stroke="#6366f1" stroke-width="1" fill="none" />
            <path d="M100,20 L100,180 M20,100 L180,100" stroke="#6366f1" stroke-width="1" />
        </svg>
        <svg class="floating-svg" style="top: 15%; right: 10%; width: 120px; animation-delay: -4s;" viewBox="0 0 100 100">
            <!-- Lotus/Flower -->
            <path d="M50,80 Q30,50 50,20 Q70,50 50,80 Z" fill="none" stroke="#f43f5e" stroke-width="2" />
            <path d="M50,80 Q10,60 20,40 Q40,40 50,80 Z" fill="none" stroke="#f43f5e" stroke-width="2" />
            <path d="M50,80 Q90,60 80,40 Q60,40 50,80 Z" fill="none" stroke="#f43f5e" stroke-width="2" />
        </svg>
        <svg class="floating-svg" style="bottom: 10%; left: 10%; width: 180px; animation-delay: -7s;" viewBox="0 0 200 100">
            <!-- Waves/Sea -->
            <path d="M0,50 Q25,30 50,50 T100,50 T150,50 T200,50" fill="none" stroke="#0ea5e9" stroke-width="2" />
            <path d="M0,70 Q25,50 50,70 T100,70 T150,70 T200,70" fill="none" stroke="#0ea5e9" stroke-width="2" opacity="0.5" />
        </svg>
        <svg class="floating-svg" style="bottom: 20%; right: 5%; width: 100px; animation-delay: -2s;" viewBox="0 0 100 100">
            <!-- Abstract geometry -->
            <rect x="25" y="25" width="50" height="50" stroke="#f59e0b" stroke-width="2" fill="none" transform="rotate(45 50 50)" />
            <circle cx="50" cy="50" r="10" fill="#f59e0b" />
        </svg>
        
        <!-- Rickshaw Doodle -->
        <svg class="floating-svg" style="top: 40%; left: 80%; width: 60px; animation: float 15s infinite linear;" viewBox="0 0 60 40">
            <rect x="10" y="10" width="30" height="20" rx="2" fill="none" stroke="#22c55e" stroke-width="2" />
            <circle cx="15" cy="35" r="5" fill="none" stroke="#22c55e" stroke-width="2" />
            <circle cx="35" cy="35" r="5" fill="none" stroke="#22c55e" stroke-width="2" />
            <path d="M40,20 L50,30" stroke="#22c55e" stroke-width="2" />
        </svg>
    </div>
    
    <div class="col-md-12 position-relative py-4">
        <div class="row mb-4">
            <div class="col-sm-12 text-center" id="welcome-title">
                <h1 class="display-4 fw-bold cinematic-title">{{ __('login.welcome', [config('name')|e])|raw }}</h1>
                <p class="lead text-muted small">Devcon 8 India: Volunteer Portal</p>
            </div>
        </div>

        <div class="row mb-4 g-3 justify-content-center">
            {% for name,date in {
                (__('event.buildup.start')): config('buildup_start'),
                (__('event.starts')): config('event_start'),
                (__('event.ends')): config('event_end'),
                (__('event.teardown.ends')): config('teardown_end')
            } | filter(date => date) %}
                {% if date > date() %}
                    <div class="col-6 col-md-3 text-center" style="max-width: 180px;">
                        <div class="countdown-card p-2 rounded-4 bg-white shadow-sm border border-light-subtle">
                            <h6 class="text-uppercase x-small fw-bold text-primary mb-1" style="font-size: 0.7rem;">{{ name }}</h6>
                            <div class="h4 mb-0 fw-bold" title="{{ date.format(__('general.datetime')) }}" data-countdown-ts="{{ date.getTimestamp() }}">%c</div>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        <div class="row mb-4">
            <div class="col-md-6 offset-md-3 col-lg-4 offset-lg-4">
                <div class="card login-card border-0 shadow-lg rounded-5 overflow-hidden">
                    <div class="card-body p-4">
                        {% include 'layouts/parts/messages.twig' %}

                        {% if session_get('show_welcome', false) %}
                            {{ m.alert(config('welcome_msg') | md, null, true) }}
                        {% endif %}

                        <form action="" enctype="multipart/form-data" method="post" id="login-form">
                            {{ csrf() }}
                            {% set login_hidden = not config('enable_password') %}
                            
                            <div class="mb-3{% if login_hidden %} d-none{% endif %}">
                                <label for="form_nick" class="form-label fw-bold small text-uppercase text-secondary" style="font-size: 0.75rem;">{{ __('general.nick') }}</label>
                                <div class="input-group input-group-sm shadow-sm rounded-3 overflow-hidden">
                                    <span class="input-group-text border-0 bg-light text-primary">
                                        {{ m.icon('person') }}
                                    </span>
                                    <input
                                        class="form-control border-0 bg-light"
                                        id="form_nick"
                                        type="text"
                                        name="login"
                                        value=""
                                        placeholder="Username"
                                        autofocus>
                                </div>
                            </div>

                            <div class="mb-3{% if login_hidden %} d-none{% endif %}">
                                <label for="form_password" class="form-label fw-bold small text-uppercase text-secondary" style="font-size: 0.75rem;">{{ __('settings.password') }}</label>
                                <div class="input-group input-group-sm shadow-sm rounded-3 overflow-hidden">
                                    <span class="input-group-text border-0 bg-light text-primary">
                                        {{ m.icon('key') }}
                                    </span>
                                    <input
                                        class="form-control border-0 bg-light" 
                                        id="form_password" 
                                        type="password"
                                        name="password" 
                                        value="" 
                                        placeholder="Password" 
                                        autocomplete="current-password"
                                    >
                                </div>
                            </div>

                            <div class="mb-3 text-center{% if login_hidden %} d-none{% endif %}">
                                <button class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm" type="submit" name="submit">
                                    {{ __('general.login') }}
                                </button>
                            </div>

                            {% if config('oauth') is not empty %}
                                <div class="d-grid gap-2 mb-3">
                                    {% for name,config in config('oauth') %}
                                        <a href="{{ url('/oauth/' ~ name) }}" class="btn btn-outline-primary btn-sm rounded-pill{% if config.hidden|default(false) %} d-none{% endif %}">
                                            {{ m.icon('shield-lock') }} {{ __( 'oauth.login-using-provider', [__(config.name|default(name|capitalize))] ) }}
                                        </a>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            <div class="text-center x-small{% if login_hidden %} d-none{% endif %}">
                                <a href="{{ url('/password/reset') }}" class="text-decoration-none text-muted" style="font-size: 0.8rem;">
                                    {{ __('login.password.reset') }}
                                </a>
                            </div>
                        </form>
                    </div>
                    
                    <div class="card-footer bg-light border-0 p-3 text-center">
                        <div class="admin-hint p-2 rounded-4 bg-white border border-warning-subtle shadow-sm">
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle mb-1" style="font-size: 0.7rem;">Admin Access</span>
                            <div class="small font-monospace text-secondary" style="font-size: 0.75rem;">
                                <strong>User:</strong> <span class="text-dark">admin</span> | 
                                <strong>Pass:</strong> <span class="text-dark">asdfasdf</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 py-4 border-top">
            <div class="col-md-6 text-center text-md-start">
                <h5 class="fw-bold">{{ __('general.register') }}</h5>
                {% if (can('register') and config('registration_enabled') and config('enable_password')) or config('external_registration_url') %}
                    <p class="text-muted small mb-2">{{ __('login.registration') }}</p>
                    {% set registration_url = config('external_registration_url') ?: url('/register') %}
                    <a href="{{ registration_url }}" class="btn btn-sm btn-outline-dark rounded-pill px-3">{{ __('general.register') }} &raquo;</a>
                {% else %}
                    <p class="text-muted small mb-0">{{ __('login.registration.disabled') }}</p>
                {% endif %}
            </div>

            <div class="col-md-6 text-center text-md-end">
                <h5 class="fw-bold">{{ __('login.do') }}</h5>
                <p class="text-muted small mb-2">{{ __('login.jobs') }}</p>
                <a href="{{ url('/angeltypes/about') }}" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                    {{ __('angeltypes.about') }} &raquo;
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .login-container {
        position: relative;
        min-height: 100vh;
        background-color: #fcfcfc;
        overflow-x: hidden;
    }
    .doodle-background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
        background: radial-gradient(circle at 50% 50%, rgba(99, 102, 241, 0.05) 0%, transparent 70%);
    }
    .floating-svg {
        position: absolute;
        opacity: 0.15;
        transition: opacity 0.5s ease;
    }
    @keyframes float {
        0% { transform: translate(0, 0) rotate(0deg); }
        33% { transform: translate(30px, -40px) rotate(10deg); }
        66% { transform: translate(-20px, 20px) rotate(-5deg); }
        100% { transform: translate(0, 0) rotate(0deg); }
    }
    .floating-svg {
        animation: float 20s infinite ease-in-out;
    }
    .cinematic-title {
        background: linear-gradient(135deg, #1e1b4b, #4338ca);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -1.5px;
    }
    .login-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(15px);
        z-index: 1;
        max-width: 380px;
        margin: 0 auto;
        box-shadow: 0 25px 50px -12px rgba(99, 102, 241, 0.15) !important;
        border: 1px solid rgba(99, 102, 241, 0.1) !important;
    }
    .countdown-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-color: rgba(99, 102, 241, 0.1) !important;
    }
    .countdown-card:hover {
        transform: translateY(-5px) scale(1.05);
        box-shadow: 0 10px 20px rgba(99, 102, 241, 0.05) !important;
    }
    .admin-hint {
        border-style: dashed !important;
        background: rgba(245, 158, 11, 0.02) !important;
    }
    .form-control:focus {
        box-shadow: 0 0 0 0.25rem rgba(99, 102, 241, 0.1);
        border-color: #6366f1;
        background-color: #fff !important;
    }
    .btn-primary {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        border: none;
        transition: all 0.3s ease;
    }
    .btn-primary:hover {
        background: linear-gradient(135deg, #4f46e5, #4338ca);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3) !important;
    }
    .x-small {
        font-size: 0.75rem;
    }
</style>
</style>
{% endblock %}
