{% extends "layouts/app.twig" %}
{% import 'macros/base.twig' as m %}

{% block title %}{{ __('general.login') }}{% endblock %}

{% block content %}
<div class="login-container">
    <div class="doodle-background"></div>
    
    <div class="col-md-12 position-relative py-5">
        <div class="row mb-5">
            <div class="col-sm-12 text-center" id="welcome-title">
                <h1 class="display-3 fw-bold cinematic-title">{{ __('login.welcome', [config('name')|e])|raw }}</h1>
                <p class="lead text-muted">Devcon 8 India: Volunteer Portal</p>
            </div>
        </div>

        <div class="row mb-5 g-4 justify-content-center">
            {% for name,date in {
                (__('event.buildup.start')): config('buildup_start'),
                (__('event.starts')): config('event_start'),
                (__('event.ends')): config('event_end'),
                (__('event.teardown.ends')): config('teardown_end')
            } | filter(date => date) %}
                {% if date > date() %}
                    <div class="col-6 col-md-3 text-center">
                        <div class="countdown-card p-3 rounded-4 bg-white shadow-sm border border-light-subtle">
                            <h6 class="text-uppercase small fw-bold text-primary mb-1">{{ name }}</h6>
                            <div class="h2 mb-0 fw-bold" title="{{ date.format(__('general.datetime')) }}" data-countdown-ts="{{ date.getTimestamp() }}">%c</div>
                            <small class="text-muted">{{ date.format(__('general.date')) }}</small>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        <div class="row mb-5">
            <div class="col-md-6 offset-md-3 col-lg-4 offset-lg-4">
                <div class="card login-card border-0 shadow-lg rounded-5 overflow-hidden">
                    <div class="card-body p-5">
                        {% include 'layouts/parts/messages.twig' %}

                        {% if session_get('show_welcome', false) %}
                            {{ m.alert(config('welcome_msg') | md, null, true) }}
                        {% endif %}

                        <form action="" enctype="multipart/form-data" method="post" id="login-form">
                            {{ csrf() }}
                            {% set login_hidden = not config('enable_password') %}
                            
                            <div class="mb-4{% if login_hidden %} d-none{% endif %}">
                                <label for="form_nick" class="form-label fw-bold small text-uppercase text-secondary">{{ __('general.nick') }}</label>
                                <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                                    <span class="input-group-text border-0 bg-light text-primary">
                                        {{ m.icon('person') }}
                                    </span>
                                    <input
                                        class="form-control border-0 bg-light"
                                        id="form_nick"
                                        type="text"
                                        name="login"
                                        value=""
                                        placeholder="Username"
                                        autofocus>
                                </div>
                            </div>

                            <div class="mb-4{% if login_hidden %} d-none{% endif %}">
                                <label for="form_password" class="form-label fw-bold small text-uppercase text-secondary">{{ __('settings.password') }}</label>
                                <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                                    <span class="input-group-text border-0 bg-light text-primary">
                                        {{ m.icon('key') }}
                                    </span>
                                    <input
                                        class="form-control border-0 bg-light" 
                                        id="form_password" 
                                        type="password"
                                        name="password" 
                                        value="" 
                                        placeholder="Password" 
                                        autocomplete="current-password"
                                    >
                                </div>
                            </div>

                            <div class="mb-4 text-center{% if login_hidden %} d-none{% endif %}">
                                <button class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow" type="submit" name="submit">
                                    {{ __('general.login') }}
                                </button>
                            </div>

                            {% if config('oauth') is not empty %}
                                <div class="d-grid gap-2 mb-4">
                                    {% for name,config in config('oauth') %}
                                        <a href="{{ url('/oauth/' ~ name) }}" class="btn btn-outline-primary btn-lg rounded-pill{% if config.hidden|default(false) %} d-none{% endif %}">
                                            {{ m.icon('shield-lock') }} {{ __( 'oauth.login-using-provider', [__(config.name|default(name|capitalize))] ) }}
                                        </a>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            <div class="text-center small{% if login_hidden %} d-none{% endif %}">
                                <a href="{{ url('/password/reset') }}" class="text-decoration-none text-muted">
                                    {{ __('login.password.reset') }}
                                </a>
                            </div>
                        </form>
                    </div>
                    
                    <div class="card-footer bg-light border-0 p-4 text-center">
                        <div class="admin-hint p-3 rounded-4 bg-white border border-info-subtle">
                            <span class="badge bg-info text-dark mb-2">Admin Access</span>
                            <div class="small font-monospace">
                                <strong>User:</strong> admin<br>
                                <strong>Pass:</strong> asdfasdf
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-5 py-5 border-top">
            <div class="col-md-6 text-center text-md-start">
                <h3 class="fw-bold">{{ __('general.register') }}</h3>
                {% if (can('register') and config('registration_enabled') and config('enable_password')) or config('external_registration_url') %}
                    <p class="text-muted">{{ __('login.registration') }}</p>
                    {% set registration_url = config('external_registration_url') ?: url('/register') %}
                    <a href="{{ registration_url }}" class="btn btn-outline-dark rounded-pill px-4">{{ __('general.register') }} &raquo;</a>
                {% else %}
                    <p class="text-muted">{{ __('login.registration.disabled') }}</p>
                {% endif %}
            </div>

            <div class="col-md-6 text-center text-md-end">
                <h3 class="fw-bold">{{ __('login.do') }}</h3>
                <p class="text-muted">{{ __('login.jobs') }}</p>
                <a href="{{ url('/angeltypes/about') }}" class="btn btn-outline-dark rounded-pill px-4">
                    {{ __('angeltypes.about') }} &raquo;
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .login-container {
        position: relative;
        min-height: 100vh;
        background-color: #fcfcfc;
        overflow: hidden;
    }
    .doodle-background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('{{ url('/images/login-doodle.png') }}');
        background-size: cover;
        background-position: center;
        opacity: 0.15;
        z-index: 0;
        pointer-events: none;
    }
    .cinematic-title {
        background: linear-gradient(135deg, #2c3e50, #000);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -2px;
    }
    .login-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        z-index: 1;
    }
    .countdown-card {
        transition: transform 0.3s ease;
    }
    .countdown-card:hover {
        transform: translateY(-5px);
    }
    .admin-hint {
        border-style: dashed !important;
    }
    .form-control:focus {
        box-shadow: none;
        border-color: var(--bs-primary);
    }
    .btn-primary {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        border: none;
    }
    .btn-primary:hover {
        background: linear-gradient(135deg, #4f46e5, #4338ca);
        transform: scale(1.02);
    }
</style>
{% endblock %}
